{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagneticTape",
  "version": "0.1.0",
  "identifier": "com.magnetictape.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MagneticTape",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MagneticTape",
    "copyright": "Copyright © 2026 MagneticTape",
    "category": "Productivity",
    "shortDescription": "本地优先的会议录音、转写与实时字幕工具",
    "longDescription": "MagneticTape 分别采集麦克风与系统声音，写入可独立恢复的 Ogg Opus 分片，并支持录后转写、实时字幕、AI 翻译和会议纪要。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

