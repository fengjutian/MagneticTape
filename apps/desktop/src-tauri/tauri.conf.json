{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagneticTape",
  "version": "0.1.0",
  "identifier": "com.magnetictape.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MagneticTape",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}

